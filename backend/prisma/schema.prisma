generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  phone       String?
  source      String
  status      String       @default("new") // "new", "contacted", "converted", "dead"
  
  requirement Requirement?
  client      Client?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Requirement {
  id                  Int      @id @default(autoincrement())
  projectTitle        String
  description         String
  technologyStack     String[]
  specialRequirements String?
  estimatedDays       Int
  targetAudience      String?
  developersRequired  Int
  experienceLevel     String
  budget              Float
  paymentType         String   // "fixed" or "hourly"
  hourlyRate          Float?
  
  leadId              Int      @unique
  lead                Lead     @relation(fields: [leadId], references: [id])
}

model Client {
  id        Int       @id @default(autoincrement())
  leadId    Int       @unique
  lead      Lead      @relation(fields: [leadId], references: [id])
  projects  Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("start") // "start", "in-progress", "completed"
  
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
}
